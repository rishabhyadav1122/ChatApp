PORT=5103
MONGO_URI=mongodb://localhost:27017
JWT_SECRET=replace_with_the_same_secret_used_by_the_other_services

# AI provider: groq or huggingface
AI_PROVIDER=groq

# Groq chat-completions API (free-plan limits apply; see Groq dashboard)
GROQ_API_KEY=your_groq_api_key
AI_MODEL=openai/gpt-oss-20b

# Hugging Face Inference Providers chat-completions API (optional alternative)
HUGGINGFACE_API_KEY=hf_your_token_with_inference_providers_permission
AI_TIMEOUT_MS=30000

# Per authenticated user, in this service process
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_WINDOW_MS=60000
